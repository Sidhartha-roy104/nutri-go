# ─────────────────────────────────────────────
# Nutri Goo — Environment Variables
# Copy this file to .env and fill in values.
# Add these same keys to Netlify → Site settings → Environment variables.
# ─────────────────────────────────────────────

# Supabase (if/when used for orders or auth)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp / contact number (optional — keep out of source if you prefer)
# VITE_WHATSAPP_NUMBER=919999999999
